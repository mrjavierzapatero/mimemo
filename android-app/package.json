{
  "name": "leteo-android",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "node scripts/copy-web.mjs && esbuild src/notifications.mjs src/speech.mjs --bundle --format=iife --target=es2022 --outdir=www",
    "sync": "npm run build:web && cap sync android",
    "assets": "node scripts/make-assets.mjs",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2",
    "sharp": "0.34.4"
  }
}
